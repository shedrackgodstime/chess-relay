; Engine configuration file.
; Chess Relay GDExtension: Rust application core + Godot bridge.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
ios_minimum_version = "17.0"

[libraries]

; Every platform we build for needs an entry. `linux.arm64` was missing, so on an
; arm64 machine the class never registered, the game screen silently rendered no
; pieces, and every bridge-dependent check was skipped while the suites reported
; success. See docs/audits/foundation_audit.md finding 2.
linux.debug.x86_64 = "res://bin/libchess_relay_core.so"
linux.release.x86_64 = "res://bin/libchess_relay_core.so"
linux.debug.arm64 = "res://bin/libchess_relay_core.so"
linux.release.arm64 = "res://bin/libchess_relay_core.so"
windows.debug.x86_64 = "res://bin/chess_relay_core.dll"
windows.release.x86_64 = "res://bin/chess_relay_core.dll"
macos.debug = "res://bin/libchess_relay_core.dylib"
macos.release = "res://bin/libchess_relay_core.dylib"
android.debug.arm64 = "res://android/libs/arm64-v8a/libchess_relay_core.so"
android.release.arm64 = "res://android/libs/arm64-v8a/libchess_relay_core.so"
android.debug.arm32 = "res://android/libs/armeabi-v7a/libchess_relay_core.so"
android.release.arm32 = "res://android/libs/armeabi-v7a/libchess_relay_core.so"
