[gd_scene load_steps=2 format=3]

; The node IS the mesh, so the shape is set on the piece itself rather than on a child
; MeshInstance3D inside it. One node and one draw call per piece, and thirty-two
; pieces plus the trays is a scene that does not need a wrapper per piece.
;
; The mesh is not authored here. It comes from PieceMeshes, which looks the identity up
; in the active model set, so swapping the set is one constant and not thirty-two edits.

[ext_resource type="Script" path="res://src/game/pieces/piece_view.gd" id="1_piece_view"]

[node name="ChessPieceView" type="MeshInstance3D"]
script = ExtResource("1_piece_view")
