[gd_scene format=3]

; The pawn as a revolved profile.
;
; A CSGPolygon3D in Spin mode is a solid of revolution: the polygon below is drawn
; in X and Y and swept around the Y axis, so it describes the pawn's silhouette and
; nothing about how it is built. Changing the silhouette means changing the polygon.
;
; Spin sides are the smoothness dial. 28 is smooth at the size a piece is seen on a
; phone and costs nothing, because this is baked to a mesh before anything ships --
; see docs/architecture/board_build_order.md, stage 3.

[node name="Pawn" type="Node3D"]

[node name="Body" type="CSGPolygon3D" parent="."]
use_collision = false
mode = 1
spin_degrees = 360.0
spin_sides = 28
polygon = PackedVector2Array(0, 0, 0.255, 0, 0.255, 0.05, 0.21, 0.072, 0.115, 0.1, 0.1, 0.2, 0.14, 0.238, 0.175, 0.272, 0.125, 0.305, 0.135, 0.338, 0.155, 0.388, 0.142, 0.438, 0.1, 0.486, 0.052, 0.516, 0, 0.522)
